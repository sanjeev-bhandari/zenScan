<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".PreviewActivity">

    <!-- Solid Elegant Toolbar at the top -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="@color/bg_dark"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:titleTextColor="@color/text_dark_primary"
        app:title="" />

    <!-- Outer overlay FrameLayout wrapping workspace and floated toolbar controls -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Main Workspace Container (Full bleed) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#030712">



            <!-- High-fidelity AI Bounding Box Layer -->
            <com.example.zenscan.view.DetectionOverlayView
                android:id="@+id/overlayView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- Hidden AI Detection Summary Badge to preserve history/state compiler targets -->
        <TextView
            android:id="@+id/summaryBadge"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            tools:ignore="UselessView" />

        <!-- Modern Loading / Processing Overlay -->
        <FrameLayout
            android:id="@+id/loadingIndicator"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#40000000"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:cardBackgroundColor="#CC1E293B"
                app:cardCornerRadius="@dimen/radius_medium"
                app:cardElevation="6dp"
                app:strokeColor="#334155"
                app:strokeWidth="@dimen/stroke_width_thin">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/spacing_large"
                    android:paddingVertical="@dimen/padding_large">

                    <ProgressBar
                        android:layout_width="@dimen/icon_size_large"
                        android:layout_height="@dimen/icon_size_large"
                        android:indeterminateTint="@color/accent_blue" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/padding_medium"
                        android:text="@string/detecting_content"
                        android:textColor="@color/text_dark_primary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>
    </FrameLayout>

    <!-- Bottom Controls Floating Sheet -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomControlsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_medium"
        app:cardBackgroundColor="@color/card_bg_dark"
        app:cardCornerRadius="@dimen/radius_huge"
        app:cardElevation="8dp"
        app:strokeColor="#334155"
        app:strokeWidth="@dimen/stroke_width_thin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_medium"
            android:paddingVertical="@dimen/bottom_controls_padding_vertical">

            <!-- Undo Action -->
            <ImageButton
                android:id="@+id/btnUndo"
                android:layout_width="@dimen/icon_size_large"
                android:layout_height="@dimen/icon_size_large"
                android:background="@drawable/badge_background"
                android:backgroundTint="#2E3B4E"
                android:contentDescription="@string/undo"
                android:padding="@dimen/padding_medium"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_undo"
                app:tint="@color/text_dark_primary" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Redact All (AI Highlight Magic Wand) -->
            <ImageButton
                android:id="@+id/btnRedactAll"
                android:layout_width="@dimen/button_redact_all_size"
                android:layout_height="@dimen/button_redact_all_size"
                android:background="@drawable/badge_background"
                android:backgroundTint="#1E1B4B"
                android:contentDescription="@string/redact_all"
                android:padding="@dimen/margin_large"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_auto_fix"
                app:tint="#A5B4FC" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Manual Brush Selection -->
            <ImageButton
                android:id="@+id/btnBrush"
                android:layout_width="@dimen/icon_size_large"
                android:layout_height="@dimen/icon_size_large"
                android:background="@drawable/badge_background"
                android:backgroundTint="#2E3B4E"
                android:contentDescription="@string/brush_tool"
                android:padding="@dimen/padding_medium"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_brush"
                app:tint="@color/text_dark_primary" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1.5" />

            <!-- Primary CTA: Export Pill Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExport"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_export_height"
                android:backgroundTint="@color/accent_blue"
                android:contentDescription="@string/export"
                android:text="@string/export"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                app:cornerRadius="@dimen/radius_extra_large"
                app:icon="@drawable/ic_export"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/margin_small"
                app:iconTint="@color/white"
                app:rippleColor="#60A5FA" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
