<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Exclude encrypted preferences whose KeyStore keys do not transfer across devices -->
    <exclude domain="sharedpref" path="zenscan_encrypted_prefs.xml" />
    <exclude domain="sharedpref" path="zenscan_prefs.xml" />
    <!-- Exclude private user images in history -->
    <exclude domain="file" path="redacted_history" />
</full-backup-content>