<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude encrypted preferences whose KeyStore keys do not transfer across devices -->
        <exclude domain="sharedpref" path="zenscan_encrypted_prefs.xml" />
        <exclude domain="sharedpref" path="zenscan_prefs.xml" />
        <!-- Exclude private user images in history -->
        <exclude domain="file" path="redacted_history" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="zenscan_encrypted_prefs.xml" />
        <exclude domain="sharedpref" path="zenscan_prefs.xml" />
        <exclude domain="file" path="redacted_history" />
    </device-transfer>
</data-extraction-rules>