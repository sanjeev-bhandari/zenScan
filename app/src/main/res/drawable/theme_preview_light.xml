<?xml version="1.0" encoding="utf-8"?>
<!-- Light Theme thumbnail -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- White app body -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F8F9FA" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- Top nav/header bar -->
    <item android:bottom="28dp">
        <shape android:shape="rectangle">
            <solid android:color="#E2E8F0" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- Content card suggestion -->
    <item android:top="14dp" android:left="5dp" android:right="5dp" android:bottom="18dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#CBD5E1" />
        </shape>
    </item>
    <!-- Bottom nav bar -->
    <item android:top="28dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#E2E8F0" />
        </shape>
    </item>
</layer-list>
